{
  "name": "ativ-04-pipeline-qualidade-seguranca",
  "version": "1.0.0",
  "description": "Pipeline CI em JavaScript com Linter, Testes Unitários, Cobertura de Código e Análise de Segurança",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "lint": "eslint src/ tests/",
    "test": "jest --ci",
    "test:coverage": "jest --coverage --ci",
    "check-secrets": "node scripts/check-secrets.js",
    "security:check": "npm run check-secrets && npm audit --audit-level=high"
  },
  "keywords": [
    "ci",
    "github-actions",
    "javascript",
    "jest",
    "eslint",
    "coverage",
    "security"
  ],
  "author": "Emilly Budri Bognar",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0"
  }
}
