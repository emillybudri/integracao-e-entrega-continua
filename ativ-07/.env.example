# Todas as variáveis são opcionais: sem este arquivo, os valores padrão abaixo são usados.

# Banco de dados MariaDB
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=wp_password

# Porta do site no seu computador
WP_PORT=8081

# Acesso ao site (criado automaticamente no primeiro boot)
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=admin123
PORTAL_ADMIN_EMAIL=admin@example.com

# 1 = cria as publicações iniciais | 0 = site vazio
PORTAL_SEED_POSTS=1

# 1 = mostra usuário e senha na tela de login (use apenas em demonstração local)
PORTAL_LOGIN_HINT=1
